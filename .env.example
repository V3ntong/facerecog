# Database
DB_SERVER=localhost
DB_NAME=FaceRecognitionDB
DB_DRIVER={ODBC Driver 18 for SQL Server}
DB_TRUST_SERVER_CERTIFICATE=yes
DB_AUTH=trusted
# If SQL auth:
# DB_USER=sa
# DB_PASSWORD=yourpassword

# Recognition
RECOGNITION_THRESHOLD=0.45
FACE_MIN_SIZE=40

# Vision LLM (Gemini)
AI_PROVIDER=gemini
# gemini-3.5-flash-lite is the fast/reliable model; gemini-flash-latest is
# higher quality but frequently rate-limited (429/503), so it is the fallback.
AI_MODEL=gemini-3.5-flash-lite
# Tried when the primary model returns 429/5xx (capacity spikes)
AI_FALLBACK_MODEL=gemini-flash-latest
AI_MAX_RETRIES=1
# Cap each request so a stuck call fails over instead of hanging the user.
AI_TIMEOUT_SECONDS=25
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Video description sampling cost knobs
VIDEO_DESCRIBE_FRAMES=4
VIDEO_FRAME_MAX_DIM=512

# Dataset
DATASET_DIR=C:\FaceDataset

# Server
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_SIZE_MB=100
RATE_LIMIT_PER_MINUTE=60
